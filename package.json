{
  "name": "client",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "test": "jest",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:css": "postcss src/styles.css -o src/tailwind.css",
    "build:web": "expo export:web"
  },
  "dependencies": {
    "@expo/webpack-config": "^19.0.0",
    "@react-navigation/native-stack": "^6.9.17",
    "autoprefixer": "^10.4.16",
    "axios": "^1.6.0",
    "expo": "~49.0.15",
    "expo-app-loading": "^2.1.1",
    "expo-font": "~11.4.0",
    "expo-splash-screen": "~0.20.5",
    "expo-status-bar": "~1.6.0",
    "firebase": "^10.7.1",
    "i18next": "^23.6.0",
    "jwt-decode": "^4.0.0",
    "postcss": "^8.4.31",
    "postcss-cli": "^10.1.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-i18next": "^13.3.1",
    "react-native": "0.72.6",
    "react-native-web": "~0.19.6",
    "styled-components": "^6.1.0",
    "tailwindcss": "^3.3.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/jest": "^29.5.11",
    "@types/react": "~18.2.14",
    "@types/react-native": "^0.72.5",
    "@types/styled-components": "^5.1.29",
    "detox": "^20.13.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.1.3"
  },
  "jest": {
    "preset": "ts-jest",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": [
        "babel-jest",
        {
          "presets": [
            "@babel/preset-env",
            "babel-preset-expo"
          ]
        }
      ]
    },
    "testEnvironment": "node",
    "globals": {
      "ts-jest": {
        "tsconfig": "./tsconfig.json"
      }
    }
  },
  "private": true
}
